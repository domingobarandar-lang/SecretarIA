# Copiar a .env y completar. El .env nunca se sube a git.

# --- Modelo (obligatorio para correr el agente) ---
ANTHROPIC_API_KEY=

# --- Opcionales: el default vive en el código ---
# Modelo a usar
# MODELO=claude-sonnet-4-20250514

# Ruta de la base SQLite del dispositivo
# RUTA_MEMORIA=datos/memoria.db

# Ruta alternativa del device.config.json (útil para probar otro cliente)
# DEVICE_CONFIG=

# Nivel de log estructurado: DEBUG | INFO | WARNING | ERROR
# LOG_NIVEL=INFO

# --- Google Workspace vía MCP (se conecta al final de la sesión 1) ---
# Las credenciales OAuth del ejecutivo nunca salen del dispositivo.
# GOOGLE_MCP_URL=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
