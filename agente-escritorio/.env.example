# Copiar a .env y completar. El .env nunca se sube a git.

# --- Proveedor del modelo (OBLIGATORIO, sin default) ---
# El agente NO arranca sin esta línea, y es a propósito: adivinar el proveedor
# cuesta plata real y el aviso llegaría con la factura.
#   gemini    -> gemini-3.1-pro-preview  (el oficial de SecretarIA)
#   anthropic -> claude-sonnet-4-20250514
LLM_PROVIDER=gemini

# La key del proveedor declarado arriba. Solo hace falta la que corresponde.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Opcionales: el default vive en el código ---
# Modelo a usar. Tapa el default del proveedor.
# MODELO=gemini-3.1-pro-preview

# Razonamiento de Gemini 3: minimal | low | medium | high (default: low).
# Los tokens de thinking se facturan a precio de salida; los turnos de
# SecretarIA son cortos y con forma de herramienta, no de investigación.
# GEMINI_THINKING=low

# Ruta de la base SQLite del dispositivo
# RUTA_MEMORIA=datos/memoria.db

# Ruta alternativa del device.config.json (útil para probar otro cliente)
# DEVICE_CONFIG=

# Nivel de log estructurado: DEBUG | INFO | WARNING | ERROR
# LOG_NIVEL=INFO

# --- Google Workspace vía los MCP oficiales de Google (pendiente) ---
# Un servidor por producto. SecretarIA solo usa Calendar y Gmail: no hay
# ninguna de las cinco tools que toque Drive.
# GOOGLE_MCP_CALENDAR=https://calendarmcp.googleapis.com/mcp/v1
# GOOGLE_MCP_GMAIL=https://gmailmcp.googleapis.com/mcp/v1
#
# Credenciales OAuth del ejecutivo. Viven en el dispositivo y no se suben nunca.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
